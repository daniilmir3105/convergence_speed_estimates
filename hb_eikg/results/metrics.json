{
  "description": "Finite-horizon Heavy Ball experiment with EIKG models",
  "external_inputs": [
    "L",
    "l"
  ],
  "forward_features": [
    "kappa",
    "log_kappa",
    "sqrt_kappa",
    "inv_sqrt_kappa",
    "alpha_L",
